# Add a Zynq UltraScale+ PS and connect its PL AXI master to the Verilog
# YOLOX bbox mailbox.  Run create_pynq_zu_rtl_project.tcl first.
set script_dir [file dirname [file normalize [info script]]]
if {[info exists ::env(PYNQ_ZU_BUILD_DIR)] && $::env(PYNQ_ZU_BUILD_DIR) ne ""} {
 set build_dir [file normalize $::env(PYNQ_ZU_BUILD_DIR)]
} else {
 set build_dir [file normalize [file join $::env(TEMP) pynq_zu_rtl]]
}
set project_file [file join $build_dir pynq_zu_rtl.xpr]
if {![file exists $project_file]} { error "Run create_pynq_zu_rtl_project.tcl first" }
open_project $project_file
set bd_dir [file join $build_dir pynq_zu_rtl.srcs sources_1 bd pynq_zu_yolox]
set existing_bd [get_files -quiet [file join $bd_dir pynq_zu_yolox.bd]]
if {[llength $existing_bd] != 0} { remove_files $existing_bd }
# This directory is generated by this script inside ignored fpga/build only;
# remove a previous partial design so the script is repeatable after failure.
if {[file exists $bd_dir]} { file delete -force $bd_dir }
create_bd_design pynq_zu_yolox

create_bd_cell -type ip -vlnv xilinx.com:ip:zynq_ultra_ps_e:3.5 zynq_ultra_ps_e_0
apply_bd_automation -rule xilinx.com:bd_rule:zynq_ultra_ps_e -config {apply_board_preset "1"} [get_bd_cells zynq_ultra_ps_e_0]
set_property -dict [list CONFIG.PSU__USE__M_AXI_GP0 {1} CONFIG.PSU__USE__M_AXI_GP1 {0}] [get_bd_cells zynq_ultra_ps_e_0]
create_bd_cell -type ip -vlnv xilinx.com:ip:smartconnect:1.0 axi_smc_0
set_property -dict [list CONFIG.NUM_SI {1} CONFIG.NUM_MI {1}] [get_bd_cells axi_smc_0]
create_bd_cell -type ip -vlnv xilinx.com:ip:util_vector_logic:2.0 reset_invert_0
set_property -dict [list CONFIG.C_OPERATION {not} CONFIG.C_SIZE {1}] [get_bd_cells reset_invert_0]
create_bd_cell -type ip -vlnv xilinx.com:ip:xlconstant:1.1 reset_locked_0
set_property -dict [list CONFIG.CONST_VAL {1} CONFIG.CONST_WIDTH {1}] [get_bd_cells reset_locked_0]
create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 proc_sys_reset_0
create_bd_cell -type module -reference dual_camera_yolox_axilite_top yolox_rtl_0

connect_bd_intf_net [get_bd_intf_pins zynq_ultra_ps_e_0/M_AXI_HPM0_FPD] [get_bd_intf_pins axi_smc_0/S00_AXI]
connect_bd_intf_net [get_bd_intf_pins axi_smc_0/M00_AXI] [get_bd_intf_pins yolox_rtl_0/S_AXI]
connect_bd_net [get_bd_pins zynq_ultra_ps_e_0/pl_clk0] [get_bd_pins zynq_ultra_ps_e_0/maxihpm0_fpd_aclk] [get_bd_pins axi_smc_0/aclk] [get_bd_pins yolox_rtl_0/clk]
connect_bd_net [get_bd_pins zynq_ultra_ps_e_0/pl_clk0] [get_bd_pins proc_sys_reset_0/slowest_sync_clk]
connect_bd_net [get_bd_pins zynq_ultra_ps_e_0/pl_resetn0] [get_bd_pins reset_invert_0/Op1]
connect_bd_net [get_bd_pins reset_invert_0/Res] [get_bd_pins proc_sys_reset_0/ext_reset_in]
connect_bd_net [get_bd_pins reset_locked_0/dout] [get_bd_pins proc_sys_reset_0/dcm_locked]
connect_bd_net [get_bd_pins proc_sys_reset_0/peripheral_reset] [get_bd_pins yolox_rtl_0/reset]
connect_bd_net [get_bd_pins proc_sys_reset_0/peripheral_aresetn] [get_bd_pins axi_smc_0/aresetn] [get_bd_pins yolox_rtl_0/s_axi_aresetn]

# Pixel/video ports remain external until the selected PYNQ-ZU capture path is known.
foreach port {pixel_valid frame_start stream_frame_id pixel_rgb_a pixel_rgb_b command_overrun frame_command_missing feature_valid_a feature_valid_b person_valid_a person_valid_b feature_a feature_b feature_similar candidate_valid confirmed consecutive_hits} {
 make_bd_pins_external [get_bd_pins yolox_rtl_0/$port]
}
assign_bd_address
validate_bd_design
save_bd_design
puts "PYNQ_ZU_YOLOX_BD_CREATED=[get_property FILE_NAME [current_bd_design]]"
